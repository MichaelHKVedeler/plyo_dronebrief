{
  "name": "dronebrief",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build && npm run build --workspace functions && npm run test:rules",
    "test:rules": "firebase emulators:exec --project demo-dronebrief --only firestore,storage \"vitest run --config vitest.firebase.config.ts\"",
    "emulators": "npm run build --workspace functions && firebase emulators:start --project demo-dronebrief",
    "bootstrap": "npm run build --workspace functions && node functions/lib/functions/src/bootstrap.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vis.gl/react-google-maps": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "lucide-react": "^1.45.0",
    "mapbox-gl-shadow-simulator": "^0.68.2",
    "maplibre-gl": "^5.24.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "tz-lookup": "^6.1.25",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/tz-lookup": "^6.1.2",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.30.2",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
