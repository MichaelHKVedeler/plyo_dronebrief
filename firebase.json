{
  "auth": {
    "providers": { "googleSignIn": { "oAuthBrandDisplayName": "Plyo Dronebrief", "supportEmail": "kristian.nordahl@plyo.com" } }
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [{ "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
  },
  "functions": [{ "source": "functions", "codebase": "dronebrief", "predeploy": ["npm run build --workspace functions"] }],
  "firestore": { "database": "(default)", "location": "europe-west1", "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "auth": { "port": 9099 }, "firestore": { "port": 8080 },
    "functions": { "port": 5001 }, "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 }, "singleProjectMode": true
  }
}
