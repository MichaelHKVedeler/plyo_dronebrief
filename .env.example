# Optional. Enable Google Maps JavaScript API in your own Google Cloud project.
# Browser API keys are public: restrict this key to your app's referrers and API.
VITE_GOOGLE_MAPS_API_KEY=
# Optional for the skeleton; uses Google's DEMO_MAP_ID when empty.
VITE_GOOGLE_MAPS_MAP_ID=
# Optional ShadeMap browser key. Keep the real value in ignored .env.local.
VITE_SHADEMAP_API_KEY=

# Firebase web configuration. Leave all blank to retain the local-only workflow.
# Browser configuration is public; backend permissions come from rules and trusted operations.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Development only. Never point emulator mode at a production project.
VITE_FIREBASE_EMULATORS=
